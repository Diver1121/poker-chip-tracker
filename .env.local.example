# Supabaseプロジェクトの Settings > API から取得
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# アプリ全体を保護する共通パスワード
APP_PASSWORD=change-me

# ログイン画面・ヘッダー・ブラウザタブに表示するアプリ名（未設定なら「チップ管理アプリ」）
APP_NAME=チップ管理アプリ ○○店

# ログインセッションの署名に使う秘密の文字列（ランダムな長い文字列にする）
SESSION_SECRET=change-me-to-a-long-random-string

# --- 自動バックアップ（任意。/api/backup をVercel Cronから叩いてGitHubにJSONをコミットする） ---
# 使わない場合はこの4つを未設定のままでOK（叩かれても500を返すだけで安全に失敗する）

# Vercel Cronからのリクエストだけを通すための合言葉。VercelのAuthorizationヘッダーと一致させる
CRON_SECRET=change-me

# バックアップ先リポジトリへのpush権限を持つGitHub Personal Access Token（Contents: Read and write）
BACKUP_GITHUB_TOKEN=

# バックアップ先リポジトリのオーナー名とリポジトリ名（この店舗専用のプライベートリポジトリを推奨）
BACKUP_GITHUB_OWNER=
BACKUP_GITHUB_REPO=
